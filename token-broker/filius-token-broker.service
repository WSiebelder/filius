[Unit]
Description=Filius local one-shot runner token broker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
EnvironmentFile=/etc/filius/orchestration.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/lib/filius/token-broker/broker.py serve
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
